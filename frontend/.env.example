# Clipper-edition build config. Copy to `.env.clipper` and fill in.
# These are PUBLIC values baked into the shipped bundle (not secrets), but the
# real .env.clipper is gitignored so nothing sensitive is ever committed by habit.
VITE_APP_EDITION=clipper
# Optional: set this to a cloud gateway if you want to enable remote workflows.
# Leave empty for local-only mode.
VITE_CLIPPER_GATEWAY_URL=
